<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer accès aux dossiers sensibles Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Bloquer les fichiers de config et fichiers sensibles à la racine
    RewriteRule ^(composer\.(json|lock)|\.env.*|artisan|phpunit\.xml)$ - [F,L]
    RewriteRule \.(md|sh|txt|log|sql|yaml|yml|lock|json|xml|ini|env|bak|orig)$ - [F,L]
    RewriteRule ^(README|CHANGELOG|Makefile|Dockerfile|\.git.*|\.editorconfig|\.npmrc|package.*|vite\.config.*|tailwind\.config.*|postcss\.config.*)$ - [F,L]

    # Fichiers statiques existants dans public/ → servir directement
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f
    RewriteRule ^(.+)$ public/$1 [L,QSA]

    # Tout le reste → index.php à la racine (ne pas bloquer les dossiers, ex: /)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
