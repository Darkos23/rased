APP_NAME=FASTEF
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.fastef.ucad.sn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=error

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fastef_prod
DB_USERNAME=fastef_user
DB_PASSWORD=

# Sessions & cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.fastef.ucad.sn
CACHE_STORE=database

# CORS — liste des origines autorisées séparées par virgule
# En dev : * | En prod : https://fastef.ucad.sn
CORS_ALLOWED_ORIGINS=https://fastef.ucad.sn

# Sanctum — domaines du SPA (frontend)
SANCTUM_STATEFUL_DOMAINS=fastef.ucad.sn

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@fastef.ucad.sn"
MAIL_FROM_NAME="FASTEF"

# DeepL translation (clé Free se termine par :fx)
DEEPL_API_KEY=

# JaaS (Jitsi as a Service) — 8x8.vc
JAAS_APP_ID=
JAAS_PRIVATE_KEY=
JAAS_KID=

# Stockage (avatars)
FILESYSTEM_DISK=public
